<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<script src="https://cdn.tailwindcss.com"></script>

<title>Cherry — Voice Assistant</title>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
    }

    .voice-ring {
        transition:
            transform 300ms ease,
            box-shadow 300ms ease;
    }

    [data-state="listening"] .voice-ring {
        transform: scale(1.06);

        box-shadow:
            0 0 0 10px rgba(37, 99, 235, 0.08),
            0 0 35px rgba(37, 99, 235, 0.35);
    }

    [data-state="processing"] .voice-ring {
        box-shadow:
            0 0 0 10px rgba(234, 179, 8, 0.08),
            0 0 35px rgba(234, 179, 8, 0.35);
    }

    [data-state="speaking"] .voice-ring {
        transform: scale(1.1);

        box-shadow:
            0 0 0 10px rgba(147, 51, 234, 0.08),
            0 0 40px rgba(147, 51, 234, 0.4);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #9ca3af;

        transition:
            background 300ms ease,
            box-shadow 300ms ease;
    }

    [data-state="listening"] .status-dot {
        background: #2563eb;
        box-shadow: 0 0 12px #2563eb;
    }

    [data-state="processing"] .status-dot {
        background: #eab308;
        box-shadow: 0 0 12px #eab308;
    }

    [data-state="speaking"] .status-dot {
        background: #9333ea;
        box-shadow: 0 0 12px #9333ea;
    }

    #voiceStatusText {
        transition: color 300ms ease;
    }

    [data-state="listening"] #voiceStatusText {
        color: #2563eb;
    }

    [data-state="processing"] #voiceStatusText {
        color: #ca8a04;
    }

    [data-state="speaking"] #voiceStatusText {
        color: #9333ea;
    }

    .container::-webkit-scrollbar {
        width: 6px;
    }

    .container::-webkit-scrollbar-track {
        background: transparent;
    }

    .container::-webkit-scrollbar-thumb {
        background: #444;
        border-radius: 999px;
    }

    .container p {
        margin: 4px 0;
    }

    .container ul,
    .container ol {
        margin: 6px 0;
        padding-left: 22px;
    }

    .container code {
        background: #eee;
        padding: 2px 5px;
        border-radius: 4px;
    }

</style>
```

</head>

<body
    class="
        bg-gray-200
        w-full
        min-h-screen
        flex
        flex-col
        lg:flex-row
        gap-2
        p-2
    "
>

```
<!-- =========================================
     CHAT PANEL
========================================== -->

<section
    class="
        rounded-md
        bg-black
        flex
        flex-col
        items-center
        flex-1
        px-4
        relative
        min-h-[50vh]
        lg:min-h-[calc(100vh-1rem)]
    "
>

    <!-- Required by talk.js -->
    <div
        class="
            container
            h-full
            w-full
            overflow-y-auto
            overflow-x-hidden
            flex
            flex-col
            gap-1
            pb-20
        "
    >
    </div>


    <!-- Text input -->

    <div
        class="
            typer
            w-[95%]
            mx-auto
            flex
            gap-2
            absolute
            bottom-2
        "
    >

        <input
            type="text"
            class="
                input-text
                flex-1
                px-3
                py-2
                text-lg
                rounded-md
                text-black
                outline-none
                bg-white
            "
            placeholder="Type a message..."
            autocomplete="off"
        >


        <button
            type="button"
            class="
                send-btn
                rounded-full
                w-[3rem]
                aspect-square
                bg-white
                flex
                items-center
                justify-center
                active:scale-90
                transition
            "
            aria-label="Send message"
        >

            <img
                class="w-[50%]"
                src="/assets/send.svg"
                alt="Send"
            >

        </button>

    </div>

</section>


<!-- =========================================
     CHERRY PANEL
========================================== -->

<section
    class="
        speak
        rounded-md
        bg-[#f9f9f9]
        flex
        items-center
        justify-center
        flex-1
        flex-col
        gap-5
        min-h-[50vh]
        lg:min-h-[calc(100vh-1rem)]
    "
>


    <!-- Required by talk.js -->

    <div
        id="voiceStatus"
        data-state="idle"
        class="
            flex
            flex-col
            items-center
            gap-4
        "
        aria-live="polite"
    >

        <!-- Voice animation -->

        <div
            class="
                voice-ring
                relative
                rounded-full
                p-3
            "
        >

            <div
                id="voicePulse"
                class="
                    rounded-full
                    overflow-hidden
                "
            >

                <img
                    class="
                        h-[35vh]
                        max-h-[320px]
                        aspect-square
                        object-contain
                    "
                    src="/assets/ai.gif"
                    alt="Cherry AI"
                >

            </div>

        </div>


        <!-- Status -->

        <div
            class="
                flex
                items-center
                gap-2
                min-h-[2rem]
                px-3
            "
        >

            <div class="status-dot"></div>

            <p
                id="voiceStatusText"
                class="
                    text-xl
                    font-semibold
                    text-gray-800
                    text-center
                    max-w-[70vw]
                    lg:max-w-[35vw]
                    break-words
                "
            >
                Click Start Cherry to speak
            </p>

        </div>

    </div>


    <!-- Required by talk.js -->

    <button
        id="startBtn"
        type="button"
        class="
            bg-blue-600
            text-white
            px-6
            py-2.5
            rounded-md
            shadow-md
            active:scale-95
            transition
        "
    >
        Start Cherry
    </button>


    <!-- Back to timetable -->

    <a
        href="/"
        class="
            bg-[#D2042D]
            text-white
            font-semibold
            py-2
            px-4
            rounded-md
            hover:bg-[#b80327]
            active:scale-95
            transition
        "
    >
        View Timetable
    </a>

</section>


<!-- =========================================
     MARKDOWN
========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
></script>


<!-- =========================================
     CHERRY VOICE CONTROLLER
========================================== -->

<script
    src="/scripts/talk.js"
></script>
