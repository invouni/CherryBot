</main>


<script>

    // ==========================================
    // CONFIGURATION
    // ==========================================

    const STUD_JSON = "/api/studentTT";
    const TEACH_JSON = "/api/teacherTT";

    const dayKeys = [
        "MON",
        "TUES",
        "WED",
        "THURS",
        "FRI",
        "SAT"
    ];

    const dayLabels = {
        MON: "Monday",
        TUES: "Tuesday",
        WED: "Wednesday",
        THURS: "Thursday",
        FRI: "Friday",
        SAT: "Saturday"
    };

    const periodKeys = [
        "I",
        "II",
        "III",
        "IV",
        "V",
        "VI",
        "VII",
        "VIII"
    ];


    // ==========================================
    // DOM
    // ==========================================

    const identity =
        document.getElementById("identity");

    const classSection =
        document.getElementById("classSection");

    const classSelect =
        document.getElementById("classSelect");

    const teacherSection =
        document.getElementById("teacherSection");

    const teacherSelect =
        document.getElementById("teacherSelect");

    const timetableBox =
        document.getElementById("timetableBox");

    const timetableGrid =
        document.getElementById("timetableGrid");

    const notes =
        document.getElementById("notes");


    let studentTimetables = null;
    let teacherTimetables = null;


    // ==========================================
    // HELPERS
    // ==========================================

    function normaliseCell(value) {

        if (
            value === undefined ||
            value === null
        ) {
            return "";
        }

        const text =
            String(value).trim();

        if (
            text === "0" ||
            text === "-" ||
            text.toLowerCase() === "free"
        ) {
            return "";
        }

        return text;
    }


    function escapeHtml(value) {

        return String(value).replace(
            /[&<>"']/g,
            character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[character]
        );

    }


    function canonicalizeSchedule(raw) {

        const result = {};

        dayKeys.forEach(day => {

            const dayObject =
                raw &&
                (
                    raw[day] ||
                    raw[day.toUpperCase()] ||
                    raw[day.toLowerCase()]
                );

            if (!dayObject) {

                result[day] = {};

                return;
            }


            const output = {};

            periodKeys.forEach(period => {

                output[period] =
                    normaliseCell(
                        dayObject[period] ??
                        dayObject[period.toUpperCase()] ??
                        dayObject[period.toLowerCase()] ??
                        ""
                    );

            });

            result[day] = output;

        });

        return result;
    }


    // ==========================================
    // RENDER GRID
    // ==========================================

    function renderGridCanonical(schedule) {

        timetableGrid.innerHTML = "";

        timetableGrid.classList.remove("hidden");


        timetableGrid.innerHTML += `
            <div class="
                font-bold
                border
                p-2
                bg-gray-100
                period-cell
            ">
                Day / Period
            </div>
        `;


        for (let i = 1; i <= 8; i++) {

            timetableGrid.innerHTML += `
                <div class="
                    font-bold
                    border
                    p-2
                    bg-gray-100
                    period-cell
                ">
                    P${i}
                </div>
            `;

        }


        dayKeys.forEach(day => {

            const dayLabel =
                dayLabels[day] || day;

            timetableGrid.innerHTML += `
                <div class="
                    font-semibold
                    border
                    p-2
                    bg-gray-50
                    period-cell
                ">
                    ${dayLabel}
                </div>
            `;


            const periods =
                schedule[day] || {};


            periodKeys.forEach(period => {

                const value =
                    periods[period] ?? "";

                const display =
                    value || "";

                timetableGrid.innerHTML += `
                    <div
                        class="border p-2 period-cell"
                        title="${escapeHtml(display)}"
                    >
                        ${escapeHtml(display)}
                    </div>
                `;

            });

        });


        timetableBox.classList.remove("hidden");
    }


    // ==========================================
    // STUDENT
    // ==========================================

    function renderStudentTT() {

        const selectedClass =
            classSelect.value;

        if (!selectedClass) return;


        const raw =
            studentTimetables &&
            (
                studentTimetables[selectedClass] ||
                studentTimetables[
                    selectedClass.toUpperCase()
                ] ||
                studentTimetables[
                    selectedClass.toLowerCase()
                ]
            );


        if (!raw) {

            notes.innerText =
                `No timetable found for class "${selectedClass}".`;

            timetableBox.classList.add("hidden");

            return;
        }


        notes.innerText =
            `Showing timetable for ${selectedClass}`;


        renderGridCanonical(
            canonicalizeSchedule(raw)
        );
    }


    // ==========================================
    // TEACHER
    // ==========================================

    function renderTeacherTT() {

        const index =
            teacherSelect.value;

        if (
            !index &&
            index !== "0"
        ) {
            return;
        }


        const teacher =
            teacherTimetables &&
            teacherTimetables[
                Number(index)
            ];


        if (!teacher) {

            notes.innerText =
                "No timetable found for selected teacher.";

            timetableBox.classList.add("hidden");

            return;
        }


        notes.innerText =
            `Showing timetable for ${teacher.name} (${teacher.designation || "Teacher"})`;


        renderGridCanonical(
            canonicalizeSchedule(
                teacher.schedule || {}
            )
        );
    }


    // ==========================================
    // POPULATE CLASS SELECT
    // ==========================================

    function populateClassSelect() {

        classSelect.innerHTML =
            '<option value="">-- Choose Class --</option>';


        if (!studentTimetables) return;


        const classes =
            Object.keys(studentTimetables);


        classes.sort(
            (a, b) =>
                a.localeCompare(
                    b,
                    undefined,
                    {
                        numeric: true
                    }
                )
        );


        classes.forEach(className => {

            const option =
                document.createElement("option");

            option.value = className;
            option.textContent = className;

            classSelect.appendChild(option);

        });
    }


    // ==========================================
    // POPULATE TEACHERS
    // ==========================================

    function populateTeacherSelect() {

        teacherSelect.innerHTML =
            '<option value="">-- Select Teacher --</option>';


        if (
            !Array.isArray(
                teacherTimetables
            )
        ) {
            return;
        }


        teacherTimetables.forEach(
            (teacher, index) => {

                const option =
                    document.createElement("option");

                option.value =
                    String(index);

                option.textContent =
                    `${teacher.name}${
                        teacher.designation
                            ? " — " + teacher.designation
                            : ""
                    }`;

                teacherSelect.appendChild(
                    option
                );

            }
        );
    }


    // ==========================================
    // IDENTITY CHANGE
    // ==========================================

    identity.addEventListener(
        "change",
        () => {

            const value =
                identity.value;


            classSection.classList.add(
                "hidden"
            );

            teacherSection.classList.add(
                "hidden"
            );

            timetableBox.classList.add(
                "hidden"
            );

            notes.innerText = "";


            if (value === "student") {

                classSection.classList.remove(
                    "hidden"
                );

            }


            if (value === "teacher") {

                teacherSection.classList.remove(
                    "hidden"
                );

            }

        }
    );


    classSelect.addEventListener(
        "change",
        renderStudentTT
    );


    teacherSelect.addEventListener(
        "change",
        renderTeacherTT
    );


    // ==========================================
    // LOAD DATA
    // ==========================================

    async function loadData() {

        try {

            const response =
                await fetch(
                    STUD_JSON,
                    {
                        cache: "no-store"
                    }
                );


            if (response.ok) {

                studentTimetables =
                    await response.json();

            }

        } catch (error) {

            console.error(
                "Unable to load student timetable:",
                error
            );

        }


        try {

            const response =
                await fetch(
                    TEACH_JSON,
                    {
                        cache: "no-store"
                    }
                );


            if (response.ok) {

                teacherTimetables =
                    await response.json();

            }

        } catch (error) {

            console.error(
                "Unable to load teacher timetable:",
                error
            );

        }


        if (
            teacherTimetables &&
            !Array.isArray(
                teacherTimetables
            )
        ) {

            if (
                teacherTimetables.name &&
                teacherTimetables.schedule
            ) {

                teacherTimetables = [
                    teacherTimetables
                ];

            } else {

                teacherTimetables =
                    Object.values(
                        teacherTimetables
                    );

            }

        }


        if (!studentTimetables) {

            notes.innerText =
                `Warning: couldn't load ${STUD_JSON}.`;

        }


        if (!teacherTimetables) {

            notes.innerText +=
                (
                    notes.innerText
                        ? "\n"
                        : ""
                ) +
                `Warning: couldn't load ${TEACH_JSON}.`;

        }


        populateClassSelect();
        populateTeacherSelect();

    }


    loadData();


    // Optional debugging helper
    window.__TIMETABLE = {

        getStudent:
            () => studentTimetables,

        getTeacher:
            () => teacherTimetables,

        renderStudentTT,

        renderTeacherTT

    };

</script>
