<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>School Timetable — Student / Teacher</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* small grid tweak */
    #timetableGrid { grid-template-columns: repeat(9, minmax(0,1fr)); }
    .period-cell { min-height:48px; display:flex; align-items:center; justify-content:center; text-align:center; white-space:pre-wrap; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-start justify-center p-6">
  <div class="bg-white shadow-lg p-6 rounded-xl w-full max-w-5xl">
    <h1 class="text-2xl font-bold mb-4 text-center">School Timetable</h1>

    <div class="grid grid-cols-3 gap-4 items-end">
      <div>
        <label class="block mb-1 font-semibold">Identity</label>
        <select id="identity" class="w-full p-2 border rounded">
          <option value="">-- Choose --</option>
          <option value="student">Student</option>
          <option value="teacher">Teacher</option>
        </select>
      </div>

      <div id="classSection" class="hidden">
        <label class="block mb-1 font-semibold">Class / Section</label>
        <select id="classSelect" class="w-full p-2 border rounded">
          <option value="">-- Choose Class --</option>
        </select>
      </div>

      <div id="teacherSection" class="hidden">
        <label class="block mb-1 font-semibold">Teacher</label>
        <select id="teacherSelect" class="w-full p-2 border rounded">
          <option value="">-- Select Teacher --</option>
        </select>
      </div>
    </div>

    <div id="timetableBox" class="mt-6 hidden">
      <h2 class="text-lg font-bold mb-3">Timetable</h2>
      <div id="timetableGrid" class="grid gap-0 border rounded overflow-hidden"></div>
    </div>

    <div id="notes" class="mt-4 text-sm text-gray-600"></div>
  </div>
  <a class="my-2 mx-auto text-white hove:text:white" href="/talk">
    <button class="bg-[#D2042D] py-2 px-3 text-white rounded-md">Talk to cherry</button>
  </a>
  

  <script>
  // ------------- Configuration & Helpers -------------
  const STUD_JSON = '/api/studentTT';
  const TEACH_JSON = '/api/teacherTT';

  const dayKeys = ['MON','TUES','WED','THURS','FRI','SAT'];
  const dayLabels = {'MON':'Monday','TUES':'Tuesday','WED':'Wednesday','THURS':'Thursday','FRI':'Friday','SAT':'Saturday'};
  const periodKeys = ['I','II','III','IV','V','VI','VII','VIII'];

  // DOM
  const identity = document.getElementById('identity');
  const classSection = document.getElementById('classSection');
  const classSelect = document.getElementById('classSelect');
  const teacherSection = document.getElementById('teacherSection');
  const teacherSelect = document.getElementById('teacherSelect');
  const timetableBox = document.getElementById('timetableBox');
  const timetableGrid = document.getElementById('timetableGrid');
  const notes = document.getElementById('notes');

  // Data holders (populated via fetch or from inline JSON if present)
  let studentTimetables = null; // expected object keyed by class (e.g. "VI", "VII", "XI SCI", ...)
  let teacherTimetables = null; // expected array of { name, designation, schedule }

  // Utility: normalise possible weird teacher entries (like "0", "0 ", "XII SCI(HIN) XI..." etc.)
  function normaliseCell(v) {
    if (v === undefined || v === null) return '';
    v = String(v).trim();
    // treat common markers as free period
    if (v === '0' || v.toLowerCase() === '0' || v === '-' || v === 'free') return '';
    return v;
  }

  // Convert a schedule object (teacher's schedule or student class schedule) into the canonical map:
  // { MON: { I: '...', II: '...' ... }, TUES: {...}, ... }
  // Student JSON already uses that shape; teacher JSON too — but sometimes teacher entries are weird strings or nested.
  function canonicalizeSchedule(raw) {
  const result = {};
  
  dayKeys.forEach(dk => {
    const dayObj = raw && (raw[dk] || raw[dk.toUpperCase()] || raw[dk.toLowerCase()]);
    if (!dayObj) {
      result[dk] = {};
      return;
    }
    
    const out = {};
    periodKeys.forEach(pk => {
      out[pk] = normaliseCell(
        dayObj[pk] ??
        dayObj[pk.toUpperCase()] ??
        dayObj[pk.toLowerCase()] ??
        ''
      );
    });
    
    result[dk] = out;
  });
  
  return result;
}

  // Render grid for a canonical schedule (object of dayKeys → { periodKeys })
  function renderGridCanonical(canon) {
    // build header row (Day / P1..P8)
    timetableGrid.innerHTML = '';
    timetableGrid.classList.remove('hidden');
    timetableGrid.innerHTML += `<div class="font-bold border p-2 bg-gray-100 period-cell">Day / Period</div>`;
    for (let i=1;i<=8;i++){
      timetableGrid.innerHTML += `<div class="font-bold border p-2 bg-gray-100 period-cell">P${i}</div>`;
    }

    dayKeys.forEach(dk => {
      const dayLabel = dayLabels[dk] || dk;
      timetableGrid.innerHTML += `<div class="font-semibold border p-2 bg-gray-50 period-cell">${dayLabel}</div>`;
      // get periods object
      const periods = canon[dk] || {};
      periodKeys.forEach(pk => {
        const raw = periods[pk] ?? '';
        // display empty if blank
        const display = raw ? raw : '';
        timetableGrid.innerHTML += `<div class="border p-2 period-cell" title="${escapeHtml(String(display))}">${escapeHtml(String(display))}</div>`;
      });
    });

    timetableBox.classList.remove('hidden');
  }

  // Render student — studentTimetables uses keys like "VI","VII","XI SCI"... its day keys are MON,TUES,...
  function renderStudentTT() {
    const cls = classSelect.value;
    if (!cls) return;
    const raw = studentTimetables && (studentTimetables[cls] || studentTimetables[cls.toUpperCase()] || studentTimetables[cls.toLowerCase()]);
    if (!raw) {
      notes.innerText = `No timetable found for class "${cls}".`;
      timetableBox.classList.add('hidden');
      return;
    }
    notes.innerText = `Showing timetable for ${cls}`;
    const canon = canonicalizeSchedule(raw);
    renderGridCanonical(canon);
  }

  // Render teacher — teacherSelect value will be the index into teacherTimetables array
  function renderTeacherTT() {
    const idx = teacherSelect.value;
    if (!idx && idx !== '0') return;
    const t = teacherTimetables && teacherTimetables[Number(idx)];
    if (!t) {
      notes.innerText = `No timetable found for selected teacher.`;
      timetableBox.classList.add('hidden');
      return;
    }
    notes.innerText = `Showing timetable for ${t.name} (${t.designation || 'Teacher'})`;
    // teacher schedule is in t.schedule
    let raw = t.schedule || {};
    // sometimes teacher schedule entries are not full period maps but short notations; attempt robust conversion:
    // If values are strings like "VII" (meaning class name), keep as is.
    // canonicalizeSchedule expects day->period->value; teacher raw seems to already have that shape, so:
    const canon = canonicalizeSchedule(raw);
    renderGridCanonical(canon);
  }

  // populate class select options from studentTimetables keys
  function populateClassSelect() {
    classSelect.innerHTML = '<option value="">-- Choose Class --</option>';
    if (!studentTimetables) return;
    const keys = Object.keys(studentTimetables);
    // sort by simple heuristic: numeric classes first, then others
    keys.sort((a,b) => {
      const na = Number(a.match(/^(\d+)|/));
      const nb = Number(b.match(/^(\d+)|/));
      if (!isNaN(na) && !isNaN(nb)) return na - nb;
      return a.localeCompare(b);
    });
    keys.forEach(k => {
      const human = k;
      const opt = document.createElement('option');
      opt.value = k;
      opt.textContent = human;
      classSelect.appendChild(opt);
    });
  }

  // populate teacher select from teacherTimetables array
  function populateTeacherSelect() {
    teacherSelect.innerHTML = '<option value="">-- Select Teacher --</option>';
    if (!Array.isArray(teacherTimetables)) return;
    teacherTimetables.forEach((t,idx) => {
      const opt = document.createElement('option');
      // value is index; label is name + designation
      opt.value = String(idx);
      opt.textContent = `${t.name}${t.designation ? ' — ' + t.designation : ''}`;
      teacherSelect.appendChild(opt);
    });
  }

  // escape for title attributes
  function escapeHtml(s) {
    return s.replace && s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // ------------- UI wiring -------------
  identity.addEventListener('change', () => {
    const val = identity.value;
    // hide all
    classSection.classList.add('hidden');
    teacherSection.classList.add('hidden');
    timetableBox.classList.add('hidden');
    notes.innerText = '';

    if (val === 'student') {
      classSection.classList.remove('hidden');
      teacherSection.classList.add('hidden');
    } else if (val === 'teacher') {
      teacherSection.classList.remove('hidden');
      classSection.classList.add('hidden');
    }
  });

  classSelect.addEventListener('change', () => {
    renderStudentTT();
  });

  teacherSelect.addEventListener('change', () => {
    renderTeacherTT();
  });

  // ------------- Data load (try fetch, else fall back to any inline variables) -------------
  async function loadData() {
    // attempt to fetch student JSON
    try {
      const sresp = await fetch(STUD_JSON, {cache:'no-store'});
      if (sresp.ok) {
        studentTimetables = await sresp.json();
      }
    } catch (e) {
      // ignore — maybe no file served
    }

    // attempt to fetch teacher JSON
    try {
      const tresp = await fetch(TEACH_JSON, {cache:'no-store'});
      if (tresp.ok) {
        teacherTimetables = await tresp.json();
      }
    } catch (e) {
      // ignore
    }

    // fallback: maybe the original HTML included variables studentTimetables / teacherTimetables inline
    if (!studentTimetables && window.studentTimetables) studentTimetables = window.studentTimetables;
    if (!teacherTimetables && window.teacherTimetables) teacherTimetables = window.teacherTimetables;

    // If teacherTimetables is an object instead of array (possible), try to convert to array
    if (teacherTimetables && !Array.isArray(teacherTimetables)) {
      // if it's an object like { name:..., schedule:... } or keyed map, convert to array
      if (teacherTimetables.name && teacherTimetables.schedule) {
        teacherTimetables = [teacherTimetables];
      } else {
        // keyed map: convert values to array
        teacherTimetables = Object.values(teacherTimetables);
      }
    }

    // final safety: ensure both exist
    if (!studentTimetables) {
      notes.innerText = `Warning: couldn't load ${STUD_JSON}. If you placed your student JSON in the same folder, ensure it's named "${STUD_JSON}" or embed the variable 'studentTimetables' into the page.`;
    }
    if (!teacherTimetables) {
      notes.innerText += (notes.innerText ? '\n' : '') + `Warning: couldn't load ${TEACH_JSON}. If you placed your teacher JSON in the same folder, ensure it's named "${TEACH_JSON}" or embed the variable 'teacherTimetables' into the page.`;
    }

    // populate selects
    populateClassSelect();
    populateTeacherSelect();
  }

  // load now
  loadData();

  // expose a debugging helper for console
  window.__TIMETABLE = {
    getStudent: () => studentTimetables,
    getTeacher: () => teacherTimetables,
    renderStudentTT,
    renderTeacherTT
  };

  </script>
</body>
</html>