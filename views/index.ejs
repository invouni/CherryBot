const textInp = document.getElementsByClassName("input-text")[0];
const sendBtn = document.getElementsByClassName("send-btn")[0];

const startBtn = document.getElementById("startBtn");
const voiceStatus = document.getElementById("voiceStatus");
const voiceStatusText = document.getElementById("voiceStatusText");

let rec = null;

let isListening = false;
let isProcessing = false;
let shouldListen = false;

let silenceTimer = null;
let finalTranscript = "";

const SILENCE_TIMEOUT = 1500;


// ============================================================
// VOICE STATE
// ============================================================

function setVoiceState(state, message) {

    if (voiceStatus) {
        voiceStatus.dataset.state = state;
    }

    if (voiceStatusText) {
        voiceStatusText.textContent = message;
    }

    if (!startBtn) return;

    startBtn.classList.remove(
        "bg-blue-600",
        "bg-red-600",
        "bg-yellow-500",
        "bg-purple-600"
    );

    if (state === "listening") {

        startBtn.textContent = "Stop Cherry";
        startBtn.classList.add("bg-red-600");

    } else if (state === "processing") {

        startBtn.textContent = "Thinking...";
        startBtn.classList.add("bg-yellow-500");

    } else if (state === "speaking") {

        startBtn.textContent = "Speaking...";
        startBtn.classList.add("bg-purple-600");

    } else {

        startBtn.textContent = "Start Cherry";
        startBtn.classList.add("bg-blue-600");
    }
}


// ============================================================
// ADD MESSAGE TO CHAT BOARD
// ============================================================

function appendMessage(text, user) {

    const container =
        document.querySelector(".container");

    if (!container) return;

    const box =
        document.createElement("div");

    box.className = `
        box
        w-[95%]
        mx-auto
        h-auto
        py-2
        px-3
        flex
        flex-col
        rounded-md
        my-[0.3rem]
        ${user === "ai"
            ? "bg-[#FFFAF5]"
            : "bg-[#DCF8C6]"
        }
    `;

    const strong =
        document.createElement("strong");

    strong.className =
        "text-black";

    strong.textContent =
        user === "ai"
            ? "Cherry"
            : "You";

    box.appendChild(strong);

    const p =
        document.createElement("p");

    p.className =
        "text-black";

    if (user === "ai") {

        if (
            typeof marked !== "undefined"
        ) {

            p.innerHTML =
                marked.parse(text);

        } else {

            p.textContent =
                text;
        }

    } else {

        p.textContent =
            text;
    }

    box.appendChild(p);

    container.appendChild(box);

    container.scrollTop =
        container.scrollHeight;
}


// ============================================================
// SILENCE TIMER
// ============================================================

function clearSilenceTimer() {

    if (silenceTimer) {

        clearTimeout(silenceTimer);

        silenceTimer = null;
    }
}


function startSilenceTimer() {

    clearSilenceTimer();

    silenceTimer =
        setTimeout(() => {

            if (
                finalTranscript.trim() &&
                !isProcessing
            ) {

                submitSpeech();
            }

        }, SILENCE_TIMEOUT);
}


// ============================================================
// SUBMIT SPEECH
// ============================================================

function submitSpeech() {

    clearSilenceTimer();

    const question =
        finalTranscript.trim();

    finalTranscript = "";

    if (!question) return;

    // Immediately show user's speech
    // on the chat board.

    appendMessage(
        question,
        "human"
    );

    sendQuestion(
        question
    );
}


// ============================================================
// SPEECH RECOGNITION
// ============================================================

function createRecognition() {

    if (
        !("webkitSpeechRecognition" in window)
    ) {

        setVoiceState(
            "idle",
            "Speech recognition is not supported"
        );

        return null;
    }

    const recognition =
        new webkitSpeechRecognition();

    recognition.continuous = true;

    recognition.interimResults = true;

    recognition.lang = "en-US";

    recognition.maxAlternatives = 1;


    // --------------------------------------------------------
    // START
    // --------------------------------------------------------

    recognition.onstart = () => {

        isListening = true;

        setVoiceState(
            "listening",
            "Listening..."
        );
    };


    // --------------------------------------------------------
    // SPEECH START
    // --------------------------------------------------------

    recognition.onspeechstart = () => {

        clearSilenceTimer();
    };


    // --------------------------------------------------------
    // SPEECH END
    // --------------------------------------------------------

    recognition.onspeechend = () => {

        startSilenceTimer();
    };


    // --------------------------------------------------------
    // RESULT
    // --------------------------------------------------------

    recognition.onresult =
        (event) => {

        let interimTranscript = "";


        for (
            let i = event.resultIndex;
            i < event.results.length;
            i++
        ) {

            const result =
                event.results[i];

            const transcript =
                result[0]
                    .transcript
                    .trim();


            if (result.isFinal) {

                finalTranscript +=
                    transcript + " ";

            } else {

                interimTranscript +=
                    transcript + " ";
            }
        }


        // Show live speech.

        if (
            interimTranscript &&
            voiceStatusText
        ) {

            voiceStatusText.textContent =
                `Listening: ${interimTranscript.trim()}`;
        }


        /*
         * Any speech resets the silence timer.
         * Once final speech is received, the timer
         * starts counting down.
         */

        if (
            interimTranscript.trim()
        ) {

            clearSilenceTimer();
        }


        if (
            finalTranscript.trim()
        ) {

            startSilenceTimer();
        }
    };


    // --------------------------------------------------------
    // ERROR
    // --------------------------------------------------------

    recognition.onerror =
        (event) => {

        if (
            event.error === "not-allowed" ||
            event.error === "service-not-allowed"
        ) {

            shouldListen = false;
            isListening = false;

            clearSilenceTimer();

            setVoiceState(
                "idle",
                "Microphone permission denied"
            );

            return;
        }


        if (
            event.error === "audio-capture"
        ) {

            shouldListen = false;
            isListening = false;

            clearSilenceTimer();

            setVoiceState(
                "idle",
                "Microphone unavailable"
            );

            return;
        }


        if (
            event.error === "network"
        ) {

            shouldListen = false;
            isListening = false;

            clearSilenceTimer();

            setVoiceState(
                "idle",
                "Speech service unavailable"
            );

            return;
        }


        if (
            event.error === "no-speech"
        ) {

            setVoiceState(
                "listening",
                "Listening..."
            );
        }
    };


    // --------------------------------------------------------
    // END
    // --------------------------------------------------------

    recognition.onend =
        () => {

        isListening = false;


        /*
         * If speech was already captured,
         * send it instead of restarting recognition.
         */

        if (
            finalTranscript.trim() &&
            !isProcessing
        ) {

            submitSpeech();

            return;
        }


        /*
         * Chrome can stop recognition automatically.
         * Restart while Cherry is active.
         */

        if (
            shouldListen &&
            !isProcessing &&
            !speechSynthesis.speaking
        ) {

            setTimeout(() => {

                if (
                    !shouldListen ||
                    isListening
                ) {
                    return;
                }

                try {

                    recognition.start();

                } catch (error) {

                    // Ignore repeated start errors.
                }

            }, 300);

            return;
        }


        if (
            !isProcessing &&
            !speechSynthesis.speaking
        ) {

            setVoiceState(
                "idle",
                "Click Start Cherry to speak"
            );
        }
    };


    return recognition;
}


// ============================================================
// START / STOP CHERRY
// ============================================================

if (
    !("webkitSpeechRecognition" in window)
) {

    setVoiceState(
        "idle",
        "Speech recognition is not supported"
    );

    if (startBtn) {
        startBtn.disabled = true;
    }

} else {

    startBtn.onclick =
        async () => {

        // ====================================================
        // STOP
        // ====================================================

        if (
            shouldListen ||
            isListening
        ) {

            shouldListen = false;
            isListening = false;

            clearSilenceTimer();

            if (rec) {

                try {
                    rec.stop();
                } catch (error) {
                    // Ignore stop errors.
                }
            }

            speechSynthesis.cancel();

            finalTranscript = "";

            setVoiceState(
                "idle",
                "Click Start Cherry to speak"
            );

            return;
        }


        // ====================================================
        // START
        // ====================================================

        try {

            /*
             * Request microphone permission.
             *
             * Chrome will use the microphone selected
             * for the current browser/system.
             */

            const stream =
                await navigator
                    .mediaDevices
                    .getUserMedia({
                        audio: true
                    });


            /*
             * This stream is only used to request/check
             * microphone permission.
             */

            stream
                .getTracks()
                .forEach(
                    track => track.stop()
                );


            rec =
                createRecognition();

            if (!rec) return;

            shouldListen = true;

            finalTranscript = "";

            rec.start();

        } catch (error) {

            shouldListen = false;
            isListening = false;

            setVoiceState(
                "idle",
                "Could not access microphone"
            );
        }
    };
}


// ============================================================
// SEND QUESTION TO SERVER
// ============================================================

async function sendQuestion(question) {

    if (
        !question ||
        isProcessing
    ) {
        return;
    }

    isProcessing = true;

    setVoiceState(
        "processing",
        "Thinking..."
    );


    try {

        const response =
            await fetch(
                "/ques",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            question
                        })
                }
            );


        if (!response.ok) {

            const errorText =
                await response.text();

            throw new Error(
                `HTTP ${response.status}: ${errorText}`
            );
        }


        const result =
            await response.json();


        /*
         * Your server currently returns:
         *
         * {
         *     responce: response.text
         * }
         */

        const answer =
            result.responce ||
            result.response;


        if (!answer) {

            throw new Error(
                "No response received from server"
            );
        }


        // Show Cherry's answer.

        appendMessage(
            answer,
            "ai"
        );


        // Speak Cherry's answer.

        speak(answer);

    } catch (error) {

        appendMessage(
            "Sorry, I couldn't get a response.",
            "ai"
        );

        setVoiceState(
            "idle",
            "Something went wrong"
        );

    } finally {

        isProcessing = false;
    }
}


// ============================================================
// TEXT INPUT
// ============================================================

sendBtn.addEventListener(
    "click",
    () => {

        const text =
            textInp.value.trim();

        if (
            !text ||
            isProcessing
        ) {
            return;
        }

        appendMessage(
            text,
            "human"
        );

        textInp.value = "";

        sendQuestion(
            text
        );
    }
);


// ============================================================
// ENTER TO SEND
// ============================================================

textInp.addEventListener(
    "keydown",
    (event) => {

        if (
            event.key === "Enter"
        ) {

            event.preventDefault();

            sendBtn.click();
        }
    }
);


// ============================================================
// TEXT TO SPEECH
// ============================================================

function speak(text) {

    speechSynthesis.cancel();


    const utterance =
        new SpeechSynthesisUtterance(
            text
        );


    utterance.lang =
        "en-US";

    utterance.rate =
        1;

    utterance.pitch =
        1;


    utterance.onstart =
        () => {

        setVoiceState(
            "speaking",
            "Speaking..."
        );
    };


    utterance.onend =
        () => {

        if (
            shouldListen
        ) {

            setVoiceState(
                "listening",
                "Listening..."
            );

        } else {

            setVoiceState(
                "idle",
                "Click Start Cherry to speak"
            );
        }
    };


    utterance.onerror =
        () => {

        if (
            shouldListen
        ) {

            setVoiceState(
                "listening",
                "Listening..."
            );

        } else {

            setVoiceState(
                "idle",
                "Click Start Cherry to speak"
            );
        }
    };


    speechSynthesis.speak(
        utterance
    );
}