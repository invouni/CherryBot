```
<main class="w-full max-w-6xl">

    <div class="bg-white shadow-lg rounded-2xl p-6">

        <!-- Header -->
        <div class="text-center mb-6">

            <h1 class="text-3xl font-bold text-gray-900">
                School Timetable
            </h1>

            <p class="text-gray-500 mt-1">
                Select your identity to view your timetable
            </p>

        </div>


        <!-- Selection -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">

            <!-- Identity -->
            <div>
                <label
                    for="identity"
                    class="block mb-1 font-semibold text-gray-700"
                >
                    Identity
                </label>

                <select
                    id="identity"
                    class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-red-400"
                >
                    <option value="">-- Choose --</option>
                    <option value="student">Student</option>
                    <option value="teacher">Teacher</option>
                </select>
            </div>


            <!-- Class -->
            <div id="classSection" class="hidden">

                <label
                    for="classSelect"
                    class="block mb-1 font-semibold text-gray-700"
                >
                    Class / Section
                </label>

                <select
                    id="classSelect"
                    class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-red-400"
                >
                    <option value="">
                        -- Choose Class --
                    </option>
                </select>

            </div>


            <!-- Teacher -->
            <div id="teacherSection" class="hidden">

                <label
                    for="teacherSelect"
                    class="block mb-1 font-semibold text-gray-700"
                >
                    Teacher
                </label>

                <select
                    id="teacherSelect"
                    class="w-full p-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-red-400"
                >
                    <option value="">
                        -- Select Teacher --
                    </option>
                </select>

            </div>

        </div>


        <!-- Timetable -->
        <div
            id="timetableBox"
            class="mt-6 hidden"
        >

            <h2 class="text-xl font-bold mb-3 text-gray-800">
                Timetable
            </h2>

            <div
                id="timetableGrid"
                class="grid gap-0 border border-gray-300 rounded-lg overflow-hidden"
            ></div>

        </div>


        <!-- Notes -->
        <div
            id="notes"
            class="mt-4 text-sm text-gray-600 whitespace-pre-line"
        ></div>

    </div>


    <!-- Talk to Cherry -->
    <div class="flex justify-center mt-5">

        <a
            href="/talk"
            class="
                inline-flex
                items-center
                justify-center
                bg-[#D2042D]
